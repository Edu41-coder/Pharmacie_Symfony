{% extends 'base.html.twig' %}

{% block title %}Contenu de la liste #{{ liste.id }}{% endblock %}

{% block body %}
    {% include 'partials/_breadcrumb_a_commander.html.twig' with {'current_route': app.request.attributes.get('_route')} %}

    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h2">Liste #{{ liste.id }}</h1>
            <a href="{{ path('a_commander_index') }}" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Retour aux listes
            </a>
        </div>

        <div class="card">
            <div class="card-header">
                <h2 class="h5 mb-0">Produits à commander</h2>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>
                                    <a href="{{ path('a_commander_show', {id: liste.id, sort: 'p.nom', direction: sortField == 'p.nom' and sortOrder == 'asc' ? 'desc' : 'asc'}) }}" class="text-decoration-none text-dark">
                                        Nom du produit
                                        {% if sortField == 'p.nom' %}
                                            <i class="fas fa-sort-{{ sortOrder == 'asc' ? 'up' : 'down' }}"></i>
                                        {% else %}
                                            <i class="fas fa-sort"></i>
                                        {% endif %}
                                    </a>
                                </th>
                                <th>Quantité</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for produit in produits %}
                                <tr>
                                    <td>{{ produit.produit.nom }}</td>
                                    <td>{{ produit.quantite }}</td>
                                    <td>
                                        <a href="{{ path('a_commander_edit_produit', {
                                            liste_id: liste.id,
                                            produit_id: produit.id
                                        }) }}" class="btn btn-sm btn-primary">
                                            <i class="fas fa-edit"></i> Modifier
                                        </a>
                                        <form action="{{ path('a_commander_delete_produit', {
                                            liste_id: liste.id,
                                            produit_id: produit.id
                                        }) }}" method="post" class="d-inline-block" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce produit de la liste ?')">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_produit' ~ produit.id) }}">
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                <i class="fas fa-trash"></i> Supprimer
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endblock %} 