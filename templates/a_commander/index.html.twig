{% extends 'base.html.twig' %}

{% block title %}À Commander{% endblock %}

{% block body %}
    {% include 'partials/_breadcrumb_a_commander.html.twig' with {'current_route': app.request.attributes.get('_route')} %}

    <div class="container-fluid">
        <h1 class="h2 mb-4">Listes À Commander</h1>

        {# Options de création #}
        <div class="card mb-4">
            <div class="card-header">
                <h2 class="h5 mb-0">Créer une nouvelle liste</h2>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <a href="{{ path('a_commander_new') }}" class="btn btn-success w-100">
                            <i class="fas fa-plus"></i> Liste vide
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a href="{{ path('a_commander_new_from_inventory') }}" class="btn btn-primary w-100">
                            <i class="fas fa-boxes"></i> Depuis l'inventaire complet
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a href="{{ path('a_commander_new_from_low_stock') }}" class="btn btn-warning w-100">
                            <i class="fas fa-exclamation-triangle"></i> Depuis le stock insuffisant
                        </a>
                    </div>
                </div>
            </div>
        </div>

        {# Liste des commandes existantes #}
        <div class="card">
            <div class="card-header">
                <h2 class="h5 mb-0">Listes existantes</h2>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>
                                    <a href="{{ path('a_commander_index', {sort: 'ac.id', direction: sortField == 'ac.id' and sortOrder == 'asc' ? 'desc' : 'asc'}) }}" class="text-decoration-none text-dark">
                                        #ID Liste
                                        {% if sortField == 'ac.id' %}
                                            <i class="fas fa-sort-{{ sortOrder == 'asc' ? 'up' : 'down' }}"></i>
                                        {% else %}
                                            <i class="fas fa-sort"></i>
                                        {% endif %}
                                    </a>
                                </th>
                                <th>Date de création</th>
                                <th>Nombre de produits</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for liste in pagination %}
                                <tr>
                                    <td>{{ liste.id }}</td>
                                    <td>{{ liste.creationCommander.createdAt ? liste.creationCommander.createdAt|date('d/m/Y H:i') : 'N/A' }}</td>
                                    <td>{{ liste.quantite }}</td>
                                    <td>
                                        <a href="{{ path('a_commander_show', {id: liste.id}) }}" class="btn btn-sm btn-info">
                                            <i class="fas fa-eye"></i> Voir la liste
                                        </a>
                                        <form action="{{ path('a_commander_delete', {id: liste.id}) }}" method="post" class="d-inline-block" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette liste ?')">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ liste.id) }}">
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                <i class="fas fa-trash"></i> Supprimer
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                {# Pagination #}
                <div class="d-flex justify-content-center mt-4">
                    {{ knp_pagination_render(pagination, 'pagination/custom_pagination.html.twig') }}
                </div>
            </div>
        </div>
    </div>
{% endblock %} 