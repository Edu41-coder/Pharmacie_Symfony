{% extends 'base.html.twig' %}

{% block title %}Modifier le client{% endblock %}

{% block body %}
<div class="container">
    {% include 'partials/_breadcrumb_client.html.twig' with {
        'current_route': 'client_edit',
        'client': client
    } %}
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h3 class="mb-0">Modifier le client</h3>
                        <a href="{{ path('client_index') }}" class="btn btn-outline-light btn-sm">
                            <i class="fas fa-arrow-left"></i> Retour
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    {{ form_start(form, {'attr': {'class': 'needs-validation'}}) }}
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                {{ form_row(form.nom) }}
                            </div>
                            <div class="col-md-6 mb-3">
                                {{ form_row(form.prenom) }}
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                {{ form_row(form.email) }}
                            </div>
                            <div class="col-md-6 mb-3">
                                {{ form_row(form.telephone) }}
                            </div>
                        </div>

                        <div class="mb-3">
                            {{ form_row(form.adresse) }}
                        </div>

                        <div class="mb-3">
                            {{ form_row(form.numeroCarteVitale) }}
                        </div>

                        <div class="mb-3">
                            {{ form_row(form.commentaire) }}
                        </div>

                        <div class="mb-3">
                            {{ form_row(form.chequesImpayes) }}
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Enregistrer les modifications
                            </button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
