{% extends 'base.html.twig' %}

{% block title %}Nouveau client{% endblock %}

{% block body %}
<div class="container">
    {% include 'partials/_breadcrumb_client.html.twig' with {'current_route': 'client_new'} %}
    
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h3 class="mb-0">Créer un nouveau client</h3>
                        <a href="{{ path('client_index') }}" class="btn btn-outline-light btn-sm">
                            <i class="fas fa-arrow-left"></i> Retour
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    {{ form_start(form, {'attr': {'class': 'needs-validation'}}) }}
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_row(form.nom, {
                                'label': 'Nom',
                                'attr': {'class': 'form-control'}
                            }) }}
                        </div>
                        <div class="col-md-6 mb-3">
                            {{ form_row(form.prenom, {
                                'label': 'Prénom',
                                'attr': {'class': 'form-control'}
                            }) }}
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_row(form.email, {
                                'label': 'Email',
                                'attr': {'class': 'form-control'}
                            }) }}
                        </div>
                        <div class="col-md-6 mb-3">
                            {{ form_row(form.telephone, {
                                'label': 'Téléphone',
                                'attr': {'class': 'form-control'}
                            }) }}
                        </div>
                    </div>

                    <div class="mb-3">
                        {{ form_row(form.adresse, {
                            'label': 'Adresse',
                            'attr': {'class': 'form-control', 'rows': 3}
                        }) }}
                    </div>

                    <div class="mb-3">
                        {{ form_row(form.numero_carte_vitale, {
                            'label': 'Numéro de carte vitale',
                            'attr': {'class': 'form-control'}
                        }) }}
                    </div>

                    <div class="mb-3">
                        {{ form_row(form.commentaire, {
                            'label': 'Commentaire',
                            'attr': {'class': 'form-control', 'rows': 3}
                        }) }}
                    </div>

                    <div class="mb-3">
                        {{ form_row(form.cheques_impayes, {
                            'label': 'Chèques impayés',
                            'attr': {'class': 'form-check-input'}
                        }) }}
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Créer le client
                        </button>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
