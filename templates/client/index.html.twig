{% extends 'base.html.twig' %}

{% block title %}Gestion des clients{% endblock %}

{% block content %}
<div class="container">
    {% include 'partials/_breadcrumb_client.html.twig' with {'current_route': 'client_index'} %}

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="search-container">
                <div class="input-group">
                    <select id="searchCriteria" class="form-select" style="max-width: 150px;">
                        <option value="nom">Par nom</option>
                        <option value="telephone">Par téléphone</option>
                        <option value="carte_vitale">Par carte vitale</option>
                    </select>
                    <input type="text" 
                           id="searchClient" 
                           class="form-control" 
                           placeholder="Rechercher un client (minimum 3 caractères)..."
                           minlength="3"
                           autocomplete="off">
                </div>
                <div id="searchResults" class="search-results d-none">
                </div>
                <div class="search-feedback text-muted small mt-1 d-none">
                    Veuillez saisir au moins 3 caractères
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Gestion des clients</h1>
        <div>
            <a href="{{ path('client_new') }}" class="btn btn-primary">
                <i class="fas fa-plus"></i> Nouveau client
            </a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>
                                <a href="{{ path('client_index', {'sort': 'c.nom', 'direction': sortField == 'c.nom' and sortOrder == 'asc' ? 'desc' : 'asc'}) }}" class="text-dark text-decoration-none">
                                    Nom
                                    {% if sortField == 'c.nom' %}
                                        <i class="fas fa-sort-{{ sortOrder == 'asc' ? 'up' : 'down' }}"></i>
                                    {% else %}
                                        <i class="fas fa-sort"></i>
                                    {% endif %}
                                </a>
                            </th>
                            <th>
                                <a href="{{ path('client_index', {'sort': 'c.prenom', 'direction': sortField == 'c.prenom' and sortOrder == 'asc' ? 'desc' : 'asc'}) }}" class="text-dark text-decoration-none">
                                    Prénom
                                    {% if sortField == 'c.prenom' %}
                                        <i class="fas fa-sort-{{ sortOrder == 'asc' ? 'up' : 'down' }}"></i>
                                    {% else %}
                                        <i class="fas fa-sort"></i>
                                    {% endif %}
                                </a>
                            </th>
                            <th>
                                <a href="{{ path('client_index', {'sort': 'c.email', 'direction': sortField == 'c.email' and sortOrder == 'asc' ? 'desc' : 'asc'}) }}" class="text-dark text-decoration-none">
                                    Email
                                    {% if sortField == 'c.email' %}
                                        <i class="fas fa-sort-{{ sortOrder == 'asc' ? 'up' : 'down' }}"></i>
                                    {% else %}
                                        <i class="fas fa-sort"></i>
                                    {% endif %}
                                </a>
                            </th>
                            <th>
                                <a href="{{ path('client_index', {'sort': 'c.telephone', 'direction': sortField == 'c.telephone' and sortOrder == 'asc' ? 'desc' : 'asc'}) }}" class="text-dark text-decoration-none">
                                    Téléphone
                                    {% if sortField == 'c.telephone' %}
                                        <i class="fas fa-sort-{{ sortOrder == 'asc' ? 'up' : 'down' }}"></i>
                                    {% else %}
                                        <i class="fas fa-sort"></i>
                                    {% endif %}
                                </a>
                            </th>
                            <th>
                                <a href="{{ path('client_index', {'sort': 'c.numeroCarteVitale', 'direction': sortField == 'c.numeroCarteVitale' and sortOrder == 'asc' ? 'desc' : 'asc'}) }}" class="text-dark text-decoration-none">
                                    Carte Vitale
                                    {% if sortField == 'c.numeroCarteVitale' %}
                                        <i class="fas fa-sort-{{ sortOrder == 'asc' ? 'up' : 'down' }}"></i>
                                    {% else %}
                                        <i class="fas fa-sort"></i>
                                    {% endif %}
                                </a>
                            </th>
                            <th>
                                <a href="{{ path('client_index', {'sort': 'c.chequesImpayes', 'direction': sortField == 'c.chequesImpayes' and sortOrder == 'asc' ? 'desc' : 'asc'}) }}" class="text-dark text-decoration-none">
                                    Chèques impayés
                                    {% if sortField == 'c.chequesImpayes' %}
                                        <i class="fas fa-sort-{{ sortOrder == 'asc' ? 'up' : 'down' }}"></i>
                                    {% else %}
                                        <i class="fas fa-sort"></i>
                                    {% endif %}
                                </a>
                            </th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for client in pagination %}
                            <tr>
                                <td>{{ client.nom }}</td>
                                <td>{{ client.prenom }}</td>
                                <td>{{ client.email }}</td>
                                <td>{{ client.telephone }}</td>
                                <td>{{ client.numeroCarteVitale }}</td>
                                <td>
                                    {% if client.chequesImpayes %}
                                        <span class="badge bg-danger">
                                            <i class="fas fa-exclamation-triangle"></i> Oui
                                        </span>
                                    {% else %}
                                        <span class="badge bg-success">Non</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="btn-group">
                                        <a href="{{ path('client_show', {'id': client.id}) }}" 
                                           class="btn btn-sm btn-outline-info" 
                                           title="Voir détails">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="{{ path('client_edit', {'id': client.id}) }}" 
                                           class="btn btn-sm btn-outline-primary" 
                                           title="Modifier">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <button type="button" 
                                                class="btn btn-sm btn-outline-danger" 
                                                data-bs-toggle="modal" 
                                                data-bs-target="#deleteModal{{ client.id }}" 
                                                title="Supprimer">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>

                            {# Modal de confirmation de suppression #}
                            <div class="modal fade" id="deleteModal{{ client.id }}" tabindex="-1">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title">Confirmer la suppression</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body">
                                            <p>Êtes-vous sûr de vouloir supprimer le client :</p>
                                            <p class="text-center fw-bold">{{ client.prenom }} {{ client.nom }}</p>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                            <form action="{{ path('client_delete', {'id': client.id}) }}" method="post" class="d-inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ client.id) }}">
                                                <button type="submit" class="btn btn-danger">Supprimer</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% else %}
                            <tr>
                                <td colspan="7" class="text-center">Aucun client trouvé</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Définir l'URL de recherche pour JavaScript
        const searchUrl = "{{ path('clients_search') }}";
    </script>
    <script src="{{ asset('js/clients/search.js') }}"></script>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}