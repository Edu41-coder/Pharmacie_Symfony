<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Pharmacie - Accueil{% endblock %}</title>
        
        {# Webpack Encore CSS #}
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}
    </head>
    <body class="d-flex flex-column min-vh-100">
        {# Header #}
        {% include 'layouts/header.html.twig' %}

        {# Contenu principal #}
        <main class="container py-4 flex-grow-1">
            {# Messages flash avec Bootstrap #}
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'info' ? 'info' : (label == 'error' ? 'danger' : label) }} alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}
            {% endfor %}
            
            {# Contenu de la page #}
            {% block body %}{% endblock %}
        </main>

        {# Footer #}
        {% include 'layouts/footer.html.twig' %}

        {# Webpack Encore JS #}
        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </body>
</html> 