{% extends 'base.html.twig' %}

{% block title %}Pharmacie - Tableau de bord{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .admin-card {
            transition: all 0.3s ease;
            border-radius: 0.5rem;
        }
        .admin-card:hover {
            background-color: #f8f9fa;
            transform: translateY(-5px);
        }
        .admin-card-link {
            color: inherit;
            text-decoration: none;
            display: block;
        }
        
        /* Styles pour notre modal personnalisé */
        .custom-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1050;
        }
        .custom-modal.show {
            display: block;
        }
        .custom-modal-backdrop {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            z-index: 1040;
        }
        .custom-modal-dialog {
            position: relative;
            width: auto;
            margin: 1.75rem auto;
            max-width: 800px;
            z-index: 1050;
        }
        .custom-modal-content {
            position: relative;
            display: flex;
            flex-direction: column;
            background-color: #fff;
            background-clip: padding-box;
            border: 1px solid rgba(0, 0, 0, 0.2);
            border-radius: 0.3rem;
            outline: 0;
            box-shadow: 0 0.25rem 0.5rem rgba(0, 0, 0, 0.5);
        }
        .custom-modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1rem;
            border-bottom: 1px solid #dee2e6;
            background-color: #f8f9fa;
            border-top-left-radius: calc(0.3rem - 1px);
            border-top-right-radius: calc(0.3rem - 1px);
        }
        .custom-modal-body {
            position: relative;
            flex: 1 1 auto;
            padding: 0;
        }
        .custom-modal-close {
            background-color: transparent;
            border: 0;
            font-size: 1.5rem;
            font-weight: 700;
            line-height: 1;
            color: #000;
            text-shadow: 0 1px 0 #fff;
            opacity: 0.5;
            padding: 0;
            margin-left: auto;
            cursor: pointer;
        }
        .custom-modal-close:hover {
            opacity: 0.75;
        }
    </style>
{% endblock %}

{% block body %}
<div class="dashboard-container">
    <div class="welcome-banner text-center py-4">
        <h1 class="display-4">{{ greeting() }}, {{ app.user.prenom }}!</h1>
        <p class="lead">Il est {{ "now"|date("H:i") }}</p>
    </div>

    <div class="container">
        {# Première ligne avec Clients, Inventaire, À Commander #}
        <div class="row g-4 justify-content-center mb-4">
            <div class="col-md-3">
                <a href="{{ path('client_index') }}" class="card action-card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <i class="fas fa-users fa-3x mb-3"></i>
                        <h5 class="card-title">Clients</h5>
                    </div>
                </a>
            </div>

            <div class="col-md-3">
                <a href="{{ path('inventaire_index') }}" class="card action-card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <i class="fas fa-boxes fa-3x mb-3"></i>
                        <h5 class="card-title">Inventaire</h5>
                    </div>
                </a>
            </div>

            <div class="col-md-3">
                <a href="{{ path('a_commander_index') }}" class="card action-card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <i class="fas fa-clipboard-list fa-3x mb-3"></i>
                        <h5 class="card-title">À Commander</h5>
                    </div>
                </a>
            </div>
        </div>

        {# Deuxième ligne avec Ventes (plus grande) #}
        <div class="row g-4 justify-content-center">
            <div class="col-md-6">
                <a href="{{ path('ventes_new') }}" class="card action-card action-card-large h-100 shadow-sm">
                    <div class="card-body text-center">
                        <i class="fas fa-cash-register fa-4x mb-3"></i>
                        <h5 class="card-title">Ventes</h5>                        
                    </div>
                </a>
            </div>

            {# Card pour pharmacien et vendeur #}
            {% if is_granted('ROLE_PHARMACIEN') or is_granted('ROLE_VENDEUR') %}
                <div class="col-md-3">
                    <a href="#" class="card action-card h-100 shadow-sm">
                        <div class="card-body text-center">
                            <i class="fas fa-folder-open fa-3x mb-3"></i>
                            <h5 class="card-title">Mes Documents</h5>
                        </div>
                    </a>
                </div>
            {% endif %}

            {# Card pour admin - avec ID pour JS #}
            {% if is_granted('ROLE_ADMIN') %}
                <div class="col-md-3">
                    <button type="button" id="adminButton" class="card action-card h-100 shadow-sm border-0 w-100 p-0">
                        <div class="card-body text-center">
                            <i class="fas fa-user-shield fa-3x mb-3"></i>
                            <h5 class="card-title">Espace Administrateur</h5>
                        </div>
                    </button>
                </div>
            {% endif %}
        </div>
    </div>
    
    {# Modal personnalisé pour l'espace administrateur #}
    {% if is_granted('ROLE_ADMIN') %}
        <div id="adminCustomModal" class="custom-modal">
            <div class="custom-modal-backdrop"></div>
            <div class="custom-modal-dialog">
                <div class="custom-modal-content">
                    <div class="custom-modal-header">
                        <h5 class="modal-title">
                            <i class="fas fa-user-shield me-2"></i> Espace Administrateur
                        </h5>
                        <button type="button" class="custom-modal-close" id="closeAdminModal">&times;</button>
                    </div>
                    <div class="custom-modal-body">
                        <div class="row g-0">
                            <div class="col-md-6 p-4 border-end">
                                <a href="#" class="admin-card-link">
                                    <div class="admin-card text-center py-4">
                                        <i class="fas fa-calculator fa-4x mb-3 text-primary"></i>
                                        <h3 class="h5">Comptabilité</h3>
                                    </div>
                                </a>
                            </div>
                            <div class="col-md-6 p-4">
                                <a href="{{ path('tva_show') }}" class="admin-card-link">
                                    <div class="admin-card text-center py-4">
                                        <i class="fas fa-percent fa-4x mb-3 text-success"></i>
                                        <h3 class="h5">TVA</h3>
                                    </div>
                                </a>
                            </div>
                        </div>
                        <div class="row g-0">
                            <div class="col-md-6 p-4 border-end border-top">
                                <a href="{{ path('commande_index') }}" class="admin-card-link">
                                    <div class="admin-card text-center py-4">
                                        <i class="fas fa-shopping-cart fa-4x mb-3 text-info"></i>
                                        <h3 class="h5">Passer Commande</h3>
                                    </div>
                                </a>
                            </div>
                            <div class="col-md-6 p-4 border-top">
                                <a href="{{ path('admin_users_index') }}" class="admin-card-link">
                                    <div class="admin-card text-center py-4">
                                        <i class="fas fa-users-cog fa-4x mb-3 text-warning"></i>
                                        <h3 class="h5">Gérer Utilisateurs</h3>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            console.log('Template DOM loaded with custom modal');
            
            // Éléments du modal
            var adminButton = document.getElementById('adminButton');
            var adminModal = document.getElementById('adminCustomModal');
            var closeButton = document.getElementById('closeAdminModal');
            var modalBackdrop = adminModal ? adminModal.querySelector('.custom-modal-backdrop') : null;
            
            // Si les éléments existent
            if (adminButton && adminModal && closeButton) {
                // Ouvrir le modal
                adminButton.addEventListener('click', function() {
                    console.log('Admin button clicked - showing custom modal');
                    document.body.style.overflow = 'hidden'; // Empêcher le défilement de la page
                    adminModal.classList.add('show');
                });
                
                // Fermer avec le bouton X
                closeButton.addEventListener('click', function() {
                    console.log('Close button clicked');
                    closeModal();
                });
                
                // Fermer en cliquant sur le backdrop
                if (modalBackdrop) {
                    modalBackdrop.addEventListener('click', function() {
                        console.log('Backdrop clicked');
                        closeModal();
                    });
                }
                
                // Fermer avec la touche Escape
                document.addEventListener('keydown', function(event) {
                    if (event.key === 'Escape' && adminModal.classList.contains('show')) {
                        console.log('Escape key pressed');
                        closeModal();
                    }
                });
                
                // Fonction pour fermer le modal
                function closeModal() {
                    adminModal.classList.remove('show');
                    document.body.style.overflow = ''; // Restaurer le défilement
                }
            }
        });
    </script>
{% endblock %}