{% extends 'base.html.twig' %}

{% block title %}Gestion des produits{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('produits') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('produits') }}
{% endblock %}

{% block content %}
<div class="container">
    {% include 'partials/_breadcrumb_produit.html.twig' with {'current_route': 'produits_index'} %}
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="search-container">
                <input type="text" 
                       id="searchProduct" 
                       class="form-control" 
                       placeholder="Rechercher un produit (minimum 3 caractères)..."
                       minlength="3"
                       autocomplete="off">
                <div id="searchResults" class="search-results d-none">
                </div>
                <div class="search-feedback text-muted small mt-1 d-none">
                    Veuillez saisir au moins 3 caractères
                </div>
            </div>
        </div>
    </div>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Liste des produits</h1>
        {% if is_granted('ROLE_ADMIN') %}
            <div data-role="ROLE_ADMIN" class="d-none"></div>
            <a href="{{ path('produits_new') }}" class="btn btn-primary">
                <i class="fas fa-plus"></i> Nouveau produit
            </a>
        {% endif %}
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>
                                <a href="{{ path('produits_index', {'sort': 'p.nom', 'direction': sortField == 'p.nom' and sortOrder == 'asc' ? 'desc' : 'asc'}) }}" class="text-dark text-decoration-none">
                                    Nom
                                    {% if sortField == 'p.nom' %}
                                        <i class="fas fa-sort-{{ sortOrder == 'asc' ? 'up' : 'down' }}"></i>
                                    {% else %}
                                        <i class="fas fa-sort"></i>
                                    {% endif %}
                                </a>
                            </th>
                            <th>
                                <a href="{{ path('produits_index', {'sort': 'p.prixVenteHt', 'direction': sortField == 'p.prixVenteHt' and sortOrder == 'asc' ? 'desc' : 'asc'}) }}" class="text-dark text-decoration-none">
                                    Prix HT
                                    {% if sortField == 'p.prixVenteHt' %}
                                        <i class="fas fa-sort-{{ sortOrder == 'asc' ? 'up' : 'down' }}"></i>
                                    {% else %}
                                        <i class="fas fa-sort"></i>
                                    {% endif %}
                                </a>
                            </th>
                            <th>
                                <a href="{{ path('produits_index', {'sort': 'p.prescription', 'direction': sortField == 'p.prescription' and sortOrder == 'asc' ? 'desc' : 'asc'}) }}" class="text-dark text-decoration-none">
                                    Prescription
                                    {% if sortField == 'p.prescription' %}
                                        <i class="fas fa-sort-{{ sortOrder == 'asc' ? 'up' : 'down' }}"></i>
                                    {% else %}
                                        <i class="fas fa-sort"></i>
                                    {% endif %}
                                </a>
                            </th>
                            <th>
                                <a href="{{ path('produits_index', {'sort': 'p.tauxRemboursement', 'direction': sortField == 'p.tauxRemboursement' and sortOrder == 'asc' ? 'desc' : 'asc'}) }}" class="text-dark text-decoration-none">
                                    Remboursement
                                    {% if sortField == 'p.tauxRemboursement' %}
                                        <i class="fas fa-sort-{{ sortOrder == 'asc' ? 'up' : 'down' }}"></i>
                                    {% else %}
                                        <i class="fas fa-sort"></i>
                                    {% endif %}
                                </a>
                            </th>
                            <th>
                                <a href="{{ path('produits_index', {'sort': 'p.alerte', 'direction': sortField == 'p.alerte' and sortOrder == 'asc' ? 'desc' : 'asc'}) }}" class="text-dark text-decoration-none">
                                    Seuil d'alerte
                                    {% if sortField == 'p.alerte' %}
                                        <i class="fas fa-sort-{{ sortOrder == 'asc' ? 'up' : 'down' }}"></i>
                                    {% else %}
                                        <i class="fas fa-sort"></i>
                                    {% endif %}
                                </a>
                            </th>
                            <th>
                                <a href="{{ path('produits_index', {'sort': 'p.declencherAlerte', 'direction': sortField == 'p.declencherAlerte' and sortOrder == 'asc' ? 'desc' : 'asc'}) }}" class="text-dark text-decoration-none">
                                    Alerte activée
                                    {% if sortField == 'p.declencherAlerte' %}
                                        <i class="fas fa-sort-{{ sortOrder == 'asc' ? 'up' : 'down' }}"></i>
                                    {% else %}
                                        <i class="fas fa-sort"></i>
                                    {% endif %}
                                </a>
                            </th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for produit in pagination %}
                            <tr>
                                <td>{{ produit.nom }}</td>
                                <td>{{ produit.prixVenteHt|number_format(2, ',', ' ') }} €</td>
                                <td>
                                    {% if produit.prescription == 'oui' %}
                                        <span class="badge bg-warning">Requise</span>
                                    {% else %}
                                        <span class="badge bg-success">Non requise</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if produit.tauxRemboursement %}
                                        <span class="badge bg-info">{{ produit.tauxRemboursement }}%</span>
                                    {% else %}
                                        <span class="badge bg-secondary">Non remboursé</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if produit.alerte %}
                                        {{ produit.alerte }} unités
                                    {% else %}
                                        <span class="text-muted">Non défini</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if produit.declencherAlerte == 'oui' %}
                                        <span class="badge bg-success">Activée</span>
                                    {% else %}
                                        <span class="badge bg-secondary">Désactivée</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="btn-group">
                                        <a href="{{ path('produits_show', {'id': produit.id}) }}" 
                                           class="btn btn-sm btn-outline-info" 
                                           title="Voir détails">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        {% if is_granted('ROLE_ADMIN') %}
                                            <a href="{{ path('produits_edit', {'id': produit.id}) }}" 
                                               class="btn btn-sm btn-outline-primary" 
                                               title="Modifier">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <button type="button" 
                                                    class="btn btn-sm btn-outline-danger" 
                                                    data-bs-toggle="modal" 
                                                    data-bs-target="#deleteModal{{ produit.id }}" 
                                                    title="Supprimer">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>

                            {% if is_granted('ROLE_ADMIN') %}
                                {# Modal de confirmation de suppression #}
                                <div class="modal fade" id="deleteModal{{ produit.id }}" tabindex="-1">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Confirmer la suppression</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p>Êtes-vous sûr de vouloir supprimer le produit :</p>
                                                <p class="text-center fw-bold">{{ produit.nom }}</p>
                                                <p class="text-danger small">Cette action est irréversible.</p>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                                <form action="{{ path('produits_delete', {'id': produit.id}) }}" method="post" class="d-inline">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ produit.id) }}">
                                                    <button type="submit" class="btn btn-danger">Supprimer</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center">Aucun produit trouvé</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<div id="deleteModalsContainer"></div>
{% endblock %} 