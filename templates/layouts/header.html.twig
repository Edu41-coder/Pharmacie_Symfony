{# Styles spécifiques pour le hover rouge #}
<style>
    /* Styles pour desktop */
    @media (min-width: 769px) {
        .logout-button-red:hover {
            background-color: rgba(220, 53, 69, 0.8) !important;
            transform: scale(1.05) !important;
        }
        .logout-button-red:hover i {
            color: rgba(220, 53, 69, 1) !important;
        }
    }

    /* Styles pour mobile */
    @media (max-width: 768px) {
        .logout-button-red:active {
            background-color: rgba(220, 53, 69, 0.8) !important;
            transform: scale(1.05) !important;
        }
        .logout-button-red:active i {
            color: rgba(220, 53, 69, 1) !important;
        }
    }
</style>

<header class="header mt-auto py-3">
    <button id="toggleHeader" class="header-toggle">
        <i class="fas fa-chevron-down"></i>
    </button>
    <div class="container">
        <div class="row">
            <div class="col-md-4">
                <a class="navbar-brand" href="{{ path('app_dashboard') }}">
                    <img src="{{ asset('build/images/logo_pharmacie.png') }}" alt="Logo Pharmacie" class="header-logo">
                </a>
            </div>
            <div class="col-md-8">
                <nav class="navbar navbar-expand-lg navbar-dark" style="padding-top: 30px !important;">
                    <!-- Bouton déconnexion pour desktop -->
                    <li class="nav-item logout-item logout-item-desktop">
                        <a class="nav-link logout-button logout-button-red" href="#" data-bs-toggle="modal" data-bs-target="#logoutModal" style="padding: 8px 16px !important; background-color: rgba(255, 255, 255, 0.1) !important; border-radius: 20px !important; display: flex !important; align-items: center !important; gap: 8px !important; transition: all 0.3s ease !important;">
                            <i class="fas fa-sign-out-alt"></i>
                            Déconnexion
                        </a>
                    </li>
                    
                    <!-- Bouton déconnexion pour mobile -->
                    <li class="nav-item logout-item logout-item-mobile">
                        <a class="nav-link logout-button logout-button-red" href="#" data-bs-toggle="modal" data-bs-target="#logoutModal" style="padding: 8px 16px !important; background-color: rgba(255, 255, 255, 0.1) !important; border-radius: 20px !important; display: flex !important; align-items: center !important; gap: 8px !important; transition: all 0.3s ease !important;">
                            <i class="fas fa-sign-out-alt"></i>
                            Déconnexion
                        </a>
                    </li>
                    
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#headerNav" aria-controls="headerNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="headerNav">
                        <ul class="navbar-nav flex-wrap" style="margin-top:28px !important;">
                            <li class="nav-item"><a class="nav-link" href="{{ path('app_dashboard') }}">Accueil</a></li>
                            <li class="nav-item"><a class="nav-link" href="{{ path('ventes_index') }}">Ventes</a></li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('produits_index') }}">Produits</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('inventaire_index') }}">Inventaire</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('a_commander_index') }}">À Commander</a>
                            </li>
                            <li class="nav-item"><a class="nav-link" href="{{ path('client_index') }}">Clients</a></li>                            
                            <li class="nav-item"><a class="nav-link disabled" href="#">Mes Documents</a></li>
                            {% if is_granted('ROLE_ADMIN') %}
                                <li class="nav-item"><a class="nav-link disabled" href="#">Comptabilité</a></li>
                                <li class="nav-item"><a class="nav-link" href="{{ path('tva_show') }}">TVA</a></li>
                                <li class="nav-item"><a class="nav-link" href="{{ path('commande_index') }}">Passer Commande</a></li>
                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('admin_users_index') }}">Gérer utilisateurs</a>
                                </li>
                            {% endif %}
                        </ul>
                    </div>
                </nav>
            </div>
        </div>
    </div>
</header>

{# Include logout modal #}
{% include 'partials/_logout_modal.html.twig' %}