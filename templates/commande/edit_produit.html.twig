{% extends 'base.html.twig' %}

{% block title %}Modifier un produit de la commande{% endblock %}

{% block body %}
    {% include 'partials/_breadcrumb_commande.html.twig' with {
        'current_route': 'commande_edit_produit',
        'commande_id': commande.id,
        'produit_nom': produit.nom
    } %}

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h1 class="h3 mb-0">Modifier un produit</h1>
                        <a href="{{ path('commande_show', {id: commande.id}) }}" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Retour
                        </a>
                    </div>
                    <div class="card-body">
                        <div class="mb-4">
                            <h2 class="h5">Produit: {{ produit.nom }}</h2>
                            <p class="text-muted">Commande #{{ commande.id }}</p>
                        </div>

                        {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
                            {{ form_row(form.quantite, {'label': 'Nouvelle quantité'}) }}
                            
                            <div class="d-flex justify-content-between mt-4">
                                <a href="{{ path('commande_show', {id: commande.id}) }}" class="btn btn-secondary">
                                    <i class="fas fa-times"></i> Annuler
                                </a>
                                <button type="submit" class="btn btn-success">
                                    <i class="fas fa-save"></i> Enregistrer
                                </button>
                            </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Validation du formulaire côté client
        (function () {
            'use strict'
            var forms = document.querySelectorAll('.needs-validation')
            Array.prototype.slice.call(forms).forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault()
                        event.stopPropagation()
                    }
                    form.classList.add('was-validated')
                }, false)
            })
        })()
    </script>
{% endblock %}
