{% extends 'base.html.twig' %}

{% block title %}Détail de la commande{% endblock %}

{% block body %}
<div class="container mt-4">
    {% include 'partials/_breadcrumb_commande.html.twig' with {'current_route': 'commande_show', 'commande': commande} %}
    
    <h1>Détails de la commande #{{ commande.id }}</h1>
    
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between">
            <h2 class="h5 mb-0">Informations générales</h2>
            <a href="{{ path('commande_index') }}" class="btn btn-secondary btn-sm">
                <i class="fas fa-arrow-left"></i> Retour à la liste
            </a>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <p><strong>Date:</strong> {{ commande.dateCommande|date('d/m/Y H:i') }}</p>
                </div>
                <div class="col-md-4">
                    <p><strong>Statut:</strong> 
                        <span class="badge {% if commande.statut == 'En attente' %}bg-warning
                                 {% elseif commande.statut == 'En cours' %}bg-info
                                 {% elseif commande.statut == 'Livrée' %}bg-success
                                 {% else %}bg-danger{% endif %}">
                            {{ commande.statut }}
                        </span>
                    </p>
                </div>
                <div class="col-md-4">
                    <p><strong>Total:</strong> {{ commande.total|number_format(2, ',', ' ') }} €</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h2 class="h5 mb-0">Produits commandés</h2>
            <a href="{{ path('commande_add_produit', {'id': commande.id}) }}" class="btn btn-sm btn-primary">
                <i class="fas fa-plus"></i> Ajouter un produit
            </a>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Produit</th>
                            <th>Quantité</th>
                            <th>Prix unitaire HT</th>
                            <th>TVA</th>
                            <th>Total TTC</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for ligne in pagination %}
                            <tr>
                                <td>{{ ligne.produit.nom }}</td>
                                <td>{{ ligne.quantite }}</td>
                                <td>{{ ligne.prixUnitaireHT|number_format(2, ',', ' ') }} €</td>
                                <td>20%</td>
                                <td>{{ ligne.montantTTC|number_format(2, ',', ' ') }} €</td>
                                <td>
                                    <div class="btn-group">
                                        <a href="{{ path('commande_edit_produit', {'commande_id': commande.id, 'produit_id': ligne.produit.id}) }}" 
                                           class="btn btn-sm btn-outline-primary" 
                                           title="Modifier">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <button type="button" 
                                                class="btn btn-sm btn-outline-danger" 
                                                title="Supprimer"
                                                data-bs-toggle="modal" 
                                                data-bs-target="#deleteModal{{ ligne.produit.id }}">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>

                                    <!-- Modal de suppression -->
                                    <div class="modal fade" id="deleteModal{{ ligne.produit.id }}" tabindex="-1">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title">Confirmation de suppression</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <p>Êtes-vous sûr de vouloir supprimer le produit "{{ ligne.produit.nom }}" de la commande ?</p>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                                    <form action="{{ path('commande_delete_produit', {'commande_id': commande.id, 'produit_id': ligne.produit.id}) }}" method="post">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_produit' ~ ligne.produit.id) }}">
                                                        <button type="submit" class="btn btn-danger">Supprimer</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center">Aucun produit dans cette commande</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="4" class="text-end">Total:</th>
                            <th>{{ commande.total|number_format(2, ',', ' ') }} €</th>
                            <th></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
            
            <div class="mt-4">
                {{ knp_pagination_render(pagination, 'pagination/custom_pagination.html.twig') }}
            </div>
        </div>
    </div>
    
    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h2 class="h5 mb-0">Mettre à jour le statut</h2>
                </div>
                <div class="card-body">
                    {{ form_start(formStatut, {'action': path('commande_update_statut', {'id': commande.id})}) }}
                        <div class="mb-3">
                            {{ form_row(formStatut.statut) }}
                        </div>
                        <button type="submit" class="btn btn-primary">Mettre à jour</button>
                    {{ form_end(formStatut) }}
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h2 class="h5 mb-0">Actions</h2>
                </div>
                <div class="card-body">
                    <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteCommandeModal">
                        <i class="fas fa-trash"></i> Supprimer la commande
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal de suppression de la commande -->
    <div class="modal fade" id="deleteCommandeModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmer la suppression</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Êtes-vous sûr de vouloir supprimer cette commande ?</p>
                    <p class="text-danger"><strong>Cette action est irréversible.</strong></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <form method="post" action="{{ path('commande_delete', {'id': commande.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ commande.id) }}">
                        <button type="submit" class="btn btn-danger">Supprimer</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
