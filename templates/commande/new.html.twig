{% extends 'base.html.twig' %}

{% block title %}Nouvelle commande{% endblock %}

{% block body %}
    {% include 'partials/_breadcrumb_commande.html.twig' with {
        'current_route': app.request.attributes.get('_route')
    } %}

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow-sm">
                    <div class="card-header">
                        <h1 class="h3 mb-0">Créer une nouvelle commande</h1>
                    </div>
                    <div class="card-body">
                        <p class="text-muted mb-4">
                            Pour commencer, ajoutez un premier produit à votre commande. 
                            Vous pourrez ajouter d'autres produits par la suite.
                        </p>

                        {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
                            <div class="row">
                                <div class="col-md-8">
                                    {{ form_row(form.produit) }}
                                </div>
                                <div class="col-md-4">
                                    {{ form_row(form.quantite) }}
                                </div>
                            </div>

                            <div class="d-flex justify-content-between mt-4">
                                <a href="{{ path('commande_index') }}" class="btn btn-secondary">
                                    <i class="fas fa-arrow-left"></i> Retour
                                </a>
                                <button type="submit" class="btn btn-success">
                                    <i class="fas fa-plus"></i> Créer la commande
                                </button>
                            </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Select2 pour le choix du produit
            if (document.querySelector('.select2')) {
                $('.select2').select2({
                    theme: 'bootstrap4',
                    placeholder: 'Sélectionnez un produit...',
                    allowClear: true
                });
            }

            // Validation du formulaire côté client
            (function () {
                'use strict'
                var forms = document.querySelectorAll('.needs-validation')
                Array.prototype.slice.call(forms).forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault()
                            event.stopPropagation()
                        }
                        form.classList.add('was-validated')
                    }, false)
                })
            })()
        });
    </script>
{% endblock %}
