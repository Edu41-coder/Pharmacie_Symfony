{% extends 'base.html.twig' %}

{% block title %}Nouvel utilisateur{% endblock %}

{% block body %}
<div class="container">
    {% include 'partials/_breadcrumb_user.html.twig' with {'current_route': 'admin_users_new'} %}
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h3 class="mb-0">Créer un nouvel utilisateur</h3>
                        <a href="{{ path('admin_users_index') }}" class="btn btn-outline-light btn-sm">
                            <i class="fas fa-arrow-left"></i> Retour
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    {{ form_start(form, {'attr': {'class': 'needs-validation'}}) }}
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                {{ form_row(form.prenom, {
                                    'label': 'Prénom',
                                    'attr': {'class': 'form-control'}
                                }) }}
                            </div>
                            <div class="col-md-6 mb-3">
                                {{ form_row(form.nom, {
                                    'label': 'Nom',
                                    'attr': {'class': 'form-control'}
                                }) }}
                            </div>
                        </div>

                        <div class="mb-3">
                            {{ form_row(form.email, {
                                'label': 'Email',
                                'attr': {'class': 'form-control'}
                            }) }}
                        </div>

                        <div class="mb-3">
                            {{ form_row(form.role, {
                                'label': 'Rôle',
                                'attr': {'class': 'form-select'}
                            }) }}
                        </div>

                        <div class="mb-3">
                            {{ form_row(form.plainPassword, {
                                'label': 'Mot de passe',
                                'attr': {'class': 'form-control'}
                            }) }}
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Créer l'utilisateur
                            </button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %} 