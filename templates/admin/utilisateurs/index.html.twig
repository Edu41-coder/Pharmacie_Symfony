{% extends 'base.html.twig' %}

{% block title %}Administration - Gestion des utilisateurs{% endblock %}

{% block body %}
<div class="container">
    {% include 'partials/_breadcrumb_user.html.twig' with {'current_route': 'admin_users_index'} %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Gestion des utilisateurs</h1>
        <a href="{{ path('admin_users_new') }}" class="btn btn-primary">
            <i class="fas fa-plus"></i> Nouvel utilisateur
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Email</th>
                            <th>Prénom</th>
                            <th>Nom</th>
                            <th>Rôle</th>
                            <th>Date création</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for user in users %}
                            <tr>
                                <td>{{ user.email }}</td>
                                <td>{{ user.prenom }}</td>
                                <td>{{ user.nom }}</td>
                                <td>
                                    {% if user.role == 'ADMIN' %}
                                        <span class="badge bg-primary">Administrateur</span>
                                    {% elseif user.role == 'PHARMACIEN' %}
                                        <span class="badge bg-success">Pharmacien</span>
                                    {% else %}
                                        <span class="badge bg-info">Vendeur</span>
                                    {% endif %}
                                </td>
                                <td>{{ user.createdAt|date('d/m/Y') }}</td>
                                <td>
                                    <div class="btn-group">
                                        <a href="{{ path('admin_users_edit', {'id': user.id}) }}" class="btn btn-sm btn-outline-primary" title="Modifier">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        {% if app.user.id != user.id %}
                                            <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal{{ user.id }}" title="Supprimer">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>

                            {# Modal de confirmation de suppression #}
                            <div class="modal fade" id="deleteModal{{ user.id }}" tabindex="-1">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title">Confirmer la suppression</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body">
                                            <p>Êtes-vous sûr de vouloir supprimer l'utilisateur :</p>
                                            <p class="text-center fw-bold">{{ user.prenom }} {{ user.nom }}</p>
                                            <p class="text-danger small">Cette action est irréversible.</p>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                            <form action="{{ path('admin_users_delete', {'id': user.id}) }}" method="post" class="d-inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                                <button type="submit" class="btn btn-danger">Supprimer</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% else %}
                            <tr>
                                <td colspan="7" class="text-center">Aucun utilisateur trouvé</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %} 