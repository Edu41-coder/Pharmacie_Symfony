<nav aria-label="breadcrumb" class="bg-light p-2 mb-4 rounded" style="margin-top: 40px;">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item">
            <a href="{{ path('app_home') }}" class="text-decoration-none">
                <i class="fas fa-home"></i> Accueil
            </a>
        </li>
        {% if current_route != 'produits_index' %}
            <li class="breadcrumb-item">
                <a href="{{ path('produits_index') }}" class="text-decoration-none">
                    <i class="fas fa-pills"></i> Produits
                </a>
            </li>
        {% else %}
            <li class="breadcrumb-item active">
                <i class="fas fa-pills"></i> Produits
            </li>
        {% endif %}
        
        {% if current_route == 'produits_new' %}
            <li class="breadcrumb-item active">
                <i class="fas fa-plus-circle"></i> Nouveau produit
            </li>
        {% elseif current_route == 'produits_edit' %}
            <li class="breadcrumb-item active">
                <i class="fas fa-edit"></i> Modifier {{ produit.nom }}
            </li>
        {% elseif current_route == 'produits_show' %}
            <li class="breadcrumb-item active">
                <i class="fas fa-eye"></i> Détails de {{ produit.nom }}
            </li>
        {% endif %}
    </ol>
</nav> 