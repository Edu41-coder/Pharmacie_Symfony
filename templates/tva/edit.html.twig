{% extends 'base.html.twig' %}

{% block title %}Modifier le taux de TVA{% endblock %}

{% block body %}
    {% include 'partials/_breadcrumb_tva.html.twig' with {'current_route': 'tva_edit'} %}

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header bg-warning">
                        <h2 class="mb-0"><i class="fas fa-edit"></i> Modifier le taux de TVA</h2>
                    </div>
                    <div class="card-body">
                        {{ form_start(form) }}
                        
                        <div class="mb-3">
                            {{ form_label(form.taux, 'Taux de TVA (%)', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.taux, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.taux) }}
                            <small class="form-text text-muted">Entrez le nouveau taux de TVA (par exemple: 20 pour 20%).</small>
                        </div>
                        
                        <div class="d-flex justify-content-between mt-4">
                            <a href="{{ path('tva_show') }}" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Retour
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save"></i> Enregistrer
                            </button>
                        </div>
                        
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
