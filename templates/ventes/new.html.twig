{% extends 'base.html.twig' %}

{% block title %}Créer une vente{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('app') }}
{% endblock %}

{% block body %}
    <div class="container vente-page">
        {# Inclusion du breadcrumb #}
        {% include 'partials/_ventes_breadcrumb.html.twig' with {
            'current_route': 'ventes_new'
        } %}
        
        <h1>Créer une nouvelle vente</h1>
        
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}
        
        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}
        
        <form id="venteForm" method="post" action="{{ path('ventes_create') }}" 
              enctype="multipart/form-data" data-csrf-token="{{ csrf_token('vente_form') }}">
            <!-- Section Client -->
            <div class="form-group mb-4">
                <h3 class="section-heading">
                    <i class="fas fa-user-circle"></i> Client
                </h3>
                <label for="client-select">Liste des clients:</label>
                <div class="client-search-container">
                    <div class="input-group mb-2">
                        <select name="client_id" id="client-select" class="form-control">
                            <option value="0">Client de passage</option>
                            {% for client in clients %}
                                <option 
                                    value="{{ client.id }}" 
                                    data-cheques-impayes="{{ client.chequesImpayes ? 'true' : 'false' }}">
                                    {{ client.nom }} {{ client.prenom }}
                                </option>
                            {% endfor %}
                        </select>
                        <div class="input-group-append">
                            <button type="button" id="clear-client" class="btn btn-outline-secondary">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </div>
                    
                    <div class="search-container">
                        <div class="input-group">
                            <select id="searchCriteria" class="form-select" style="max-width: 150px;">
                                <option value="nom">Par nom</option>
                                <option value="telephone">Par téléphone</option>
                                <option value="carte_vitale">Par carte vitale</option>
                            </select>
                            <input type="text" 
                                id="searchClient" 
                                class="form-control" 
                                placeholder="Rechercher un client (minimum 3 caractères)..."
                                minlength="3"
                                autocomplete="off">
                        </div>
                        <div id="searchResults" class="search-results d-none">
                        </div>
                        <div class="search-feedback text-muted small mt-1 d-none">
                            Veuillez saisir au moins 3 caractères
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section Produits -->
            <div id="produits" class="mb-4"></div>
            <h3 class="section-heading">
                <i class="fas fa-pills"></i> Produits
            </h3>
            <div class="produits-container">
                <div class="produit-ligne mb-3">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="produit-search-container">
                                <!-- Menu déroulant sur la première ligne -->
                                <div class="select-container">
                                    <select name="produit_id[]" class="form-control produit-select" required>
                                        <option value="">Sélectionnez un produit</option>
                                        {% for produit in produits %}
                                            {% set tvaValue = tva is defined ? tva : 20 %}
                                            <option value="{{ produit.id }}"
                                                data-prix="{{ (produit.prixVenteHt * (1 + (tvaValue/100)))|number_format(2, '.', '') }}"
                                                data-taux="{{ produit.tauxRemboursement }}"
                                                data-prescription="{{ produit.prescription }}"
                                                data-stock="{{ produit.stock|default(0) }}">
                                                {{ produit.nom }} (Stock: {{ produit.stock|default(0) }})
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <!-- Barre de recherche sur la deuxième ligne -->
                                <div class="search-container">
                                    <input type="text" class="form-control produit-search" placeholder="Rechercher un produit...">
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <input type="number"
                                name="quantite[]"
                                class="form-control quantite"
                                min="1"
                                value="1"
                                required
                                title="Entrez la quantité souhaitée">
                        </div>
                        <div class="col-md-4">
                            <!-- Remplacer justify-content-between par justify-content-start -->
                            <div class="d-flex justify-content-start align-items-center">
                                <div class="me-4">
                                    <small class="d-block text-muted">Prix total:</small>
                                    <span class="prix-total font-weight-bold">0.00€</span>
                                </div>
                                <div>
                                    <small class="d-block text-muted">À rembourser:</small>
                                    <span class="montant-a-rembourser font-weight-bold">0.00€</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <button type="button"
                                class="btn btn-outline-danger supprimer-produit"
                                title="Supprimer ce produit">
                                <i class="fas fa-trash text-danger"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Champs Ordonnance -->
                    <div class="ordonnance-fields" style="display: none;">
                        <div class="row">
                            <div class="col-md-4">
                                <input type="text"
                                    name="numero_ordonnance[]"
                                    class="form-control"
                                    placeholder="Numéro d'ordonnance">
                            </div>
                            <div class="col-md-4">
                                <input type="text"
                                    name="numero_ordre[]"
                                    class="form-control"
                                    placeholder="Numéro d'ordre"
                                    title="Numéro d'ordre du médecin">
                            </div>
                            <div class="col-md-4">
                                <input type="file"
                                    name="image_ordonnance[]"
                                    class="form-control"
                                    accept="image/*"
                                    title="Image de l'ordonnance">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bouton Ajouter Produit -->
            <button type="button"
                id="ajouter-produit"
                class="btn btn-success mb-4"
                ontouchstart="event.preventDefault();"
                onclick="event.preventDefault();">
                <i class="fas fa-plus"></i> Ajouter un produit
            </button>

            <!-- Section Totaux -->
            <div class="totals-section">
                <div class="d-flex flex-wrap justify-content-between align-items-center">
                    <div class="montant-item">
                        <p class="mb-0"><strong>Montant total:</strong> <span id="montant_total" class="montant-value">0.00€</span></p>
                    </div>
                    <div class="montant-item">
                        <p class="mb-0"><strong>Montant à rembourser:</strong> <span id="montant_a_rembourser" class="montant-value">0.00€</span></p>
                    </div>
                    <div class="montant-item">
                        <p class="mb-0"><strong>Montant à régler:</strong> <span id="montant_a_regler" class="montant-value">0.00€</span></p>
                    </div>
                </div>
            </div>

            <!-- Section Paiement -->
            <div class="payment-section">
                <h3 class="section-heading">
                    <i class="fas fa-credit-card"></i> Mode de paiement
                </h3>
                <div class="row">
                    <div class="col-md-4">
                        <div>
                            <input type="checkbox"
                                name="mode_encaissement[]"
                                value="especes"
                                class="form-check-input"
                                title="Paiement en espèces">
                            <label class="form-check-label">Espèces</label>
                            <div class="especes-inputs">
                                <input type="number"
                                    step="0.01"
                                    name="montant_especes"
                                    class="form-control montant-paiement mb-2"
                                    disabled
                                    title="Montant en espèces">
                                <input type="number"
                                    step="0.01"
                                    name="montant_paye_especes"
                                    class="form-control mb-2"
                                    disabled
                                    placeholder="Payé"
                                    title="Montant payé par le client">
                                <div class="monnaie-a-rendre">
                                    Monnaie à rendre: <span class="monnaie-montant">0.00€</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div>
                            <input type="checkbox"
                                name="mode_encaissement[]"
                                value="carte_bleu"
                                class="form-check-input"
                                title="Paiement par carte bancaire">
                            <label class="form-check-label">Carte bancaire</label>
                            <input type="number"
                                step="0.01"
                                name="montant_cb"
                                class="form-control montant-paiement"
                                disabled
                                title="Montant par carte">
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div>
                            <input type="checkbox"
                                name="mode_encaissement[]"
                                value="cheque"
                                class="form-check-input"
                                title="Paiement par chèque">
                            <label class="form-check-label">Chèque</label>
                            <input type="number"
                                step="0.01"
                                name="montant_cheque"
                                class="form-control montant-paiement"
                                disabled
                                title="Montant par chèque">
                            <input type="text"
                                name="numero_cheque"
                                class="form-control mt-2"
                                placeholder="Numéro du chèque"
                                disabled
                                title="Numéro du chèque">
                        </div>
                    </div>
                </div>
                <p class="mt-3">Montant restant à payer: <span id="montant_restant">0.00€</span></p>
            </div>

            <!-- Options supplémentaires -->
            <div class="facture-checkbox">
                <label for="creer_facture" class="btn-facture">
                    <input type="checkbox"
                        id="creer_facture"
                        name="creer_facture"
                        value="1"
                        title="Générer une facture">
                    <i class="fas fa-file-invoice"></i> Créer une facture
                </label>
            </div>

            <div class="form-group mt-4">
                <label for="commentaire">Commentaire:</label>
                <textarea name="commentaire"
                    id="commentaire"
                    class="form-control"
                    title="Ajouter un commentaire à la vente"></textarea>
            </div>

            <!-- Bouton de soumission -->
            <button type="submit"
                class="btn btn-primary mt-4"
                title="Enregistrer la vente">
                <i class="fas fa-save"></i> Enregistrer la vente
            </button>
            
            <!-- CSRF Token -->
            <input type="hidden" name="_token" value="{{ csrf_token('vente_form') }}">
        </form>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('ventes') }}
    <script>
        // Définir l'URL de recherche pour JavaScript
        const searchUrl = "{{ path('clients_search') }}";
    </script>
    <script src="{{ asset('js/clients/search.js') }}"></script>
    <script src="{{ asset('js/clients/client-selector.js') }}"></script>
{% endblock %}