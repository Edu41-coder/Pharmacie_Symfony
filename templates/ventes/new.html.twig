{% extends 'base.html.twig' %}

{% block title %}Créer une vente{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {# Removing or replacing the non-existent 'ventes' entry point #}
    {# {{ encore_entry_link_tags('ventes') }} #}
    
    {# Use the app entry point which is available #}
    {{ encore_entry_link_tags('app') }}
    
    <style>
        /* Add any custom styles directly here if needed */
        .client-section, .produits-section {
            margin-bottom: 2rem;
        }
        
        .product-card {
            transition: all 0.2s;
        }
        
        .product-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }
        
        /* Styles for section headings with icons */
        h3.section-heading {
            color: #0d47a1; /* Dark blue color */
            display: flex;
            align-items: center;
            margin-bottom: 1rem;
            font-weight: 600;
        }
        
        h3.section-heading i {
            margin-right: 10px;
            transition: all 0.3s ease;
        }
        
        h3.section-heading:hover i {
            animation: pulse 1s infinite;
            transform: scale(1.2);
        }
        
        @keyframes pulse {
            0% { opacity: 1; }
            50% { opacity: 0.6; }
            100% { opacity: 1; }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container">
        <h1>Créer une nouvelle vente</h1>
        
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}
        
        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}
        
        <form id="venteForm" method="post" action="{{ path('ventes_create') }}" enctype="multipart/form-data">
            <!-- Section Client -->
            <div class="form-group mb-4">
                <h3 class="section-heading">
                    <i class="fas fa-user-circle"></i> Client
                </h3>
                <label for="client">Liste des clients:</label>
                <div class="client-search-container">
                    <select name="client_id" id="client" class="form-control">
                        <option value="0">Client de passage</option>
                        {% for client in clients %}
                            <option 
                                value="{{ client.id }}" 
                                data-cheques-impayes="{{ client.chequesImpayes ? 'true' : 'false' }}">
                                {{ client.nom }} {{ client.prenom }}
                            </option>
                        {% endfor %}
                    </select>
                    <input type="text"
                        id="client-search"
                        class="form-control"
                        placeholder="Rechercher un client..."
                        autocomplete="off"
                        title="Rechercher un client par nom ou prénom">
                </div>
            </div>

            <!-- Section Produits -->
            <div id="produits" class="mb-4"></div>
            <h3 class="section-heading">
                <i class="fas fa-pills"></i> Produits
            </h3>
            <div class="produits-container">
                <div class="produit-ligne mb-3">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="produit-search-container">
                                <!-- Menu déroulant sur la première ligne -->
                                <div class="select-container">
                                    <select name="produit_id[]" class="form-control produit-select" required>
                                        <option value="">Sélectionnez un produit</option>
                                        {% for produit in produits %}
                                            {% set tvaValue = tva is defined ? tva : 20 %}
                                            <option value="{{ produit.id }}"
                                                data-prix="{{ (produit.prixVenteHt * (1 + (tvaValue/100)))|number_format(2, '.', '') }}"
                                                data-taux="{{ produit.tauxRemboursement }}"
                                                data-prescription="{{ produit.prescription }}"
                                                data-stock="{{ produit.stock|default(0) }}">
                                                {{ produit.nom }} (Stock: {{ produit.stock|default(0) }})
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <!-- Barre de recherche sur la deuxième ligne -->
                                <div class="search-container">
                                    <input type="text" class="form-control produit-search" placeholder="Rechercher un produit...">
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <input type="number"
                                name="quantite[]"
                                class="form-control quantite"
                                min="1"
                                value="1"
                                required
                                title="Entrez la quantité souhaitée">
                        </div>
                        <div class="col-md-2">
                            <span class="prix-total"></span>
                        </div>
                        <div class="col-md-2">
                            <span class="montant-a-rembourser"></span>
                        </div>
                        <div class="col-md-2">
                            <button type="button"
                                class="btn btn-outline-danger supprimer-produit"
                                title="Supprimer ce produit">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Champs Ordonnance -->
                    <div class="ordonnance-fields" style="display: none;">
                        <div class="row">
                            <div class="col-md-4">
                                <input type="text"
                                    name="numero_ordonnance[]"
                                    class="form-control"
                                    placeholder="Numéro d'ordonnance">
                            </div>
                            <div class="col-md-4">
                                <input type="text"
                                    name="numero_ordre[]"
                                    class="form-control"
                                    placeholder="Numéro d'ordre"
                                    title="Numéro d'ordre du médecin">
                            </div>
                            <div class="col-md-4">
                                <input type="file"
                                    name="image_ordonnance[]"
                                    class="form-control"
                                    accept="image/*"
                                    title="Image de l'ordonnance">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bouton Ajouter Produit -->
            <button type="button"
                id="ajouter-produit"
                class="btn btn-success mb-4"
                ontouchstart="event.preventDefault();"
                onclick="event.preventDefault();">
                <i class="fas fa-plus"></i> Ajouter un produit
            </button>

            <!-- Section Totaux -->
            <div class="totals-section">
                <div class="row">
                    <div class="col-md-4">
                        <p>Montant total: <span id="montant_total">0.00€</span></p>
                    </div>
                    <div class="col-md-4">
                        <p>Montant à rembourser: <span id="montant_a_rembourser">0.00€</span></p>
                    </div>
                    <div class="col-md-4">
                        <p>Montant à régler: <span id="montant_a_regler">0.00€</span></p>
                    </div>
                </div>
            </div>

            <!-- Section Paiement -->
            <div class="payment-section">
                <h3 class="section-heading">
                    <i class="fas fa-credit-card"></i> Mode de paiement
                </h3>
                <div class="row">
                    <div class="col-md-4">
                        <div>
                            <input type="checkbox"
                                name="mode_encaissement[]"
                                value="especes"
                                class="form-check-input"
                                title="Paiement en espèces">
                            <label class="form-check-label">Espèces</label>
                            <div class="especes-inputs">
                                <input type="number"
                                    step="0.01"
                                    name="montant_especes"
                                    class="form-control montant-paiement mb-2"
                                    disabled
                                    title="Montant en espèces">
                                <input type="number"
                                    step="0.01"
                                    name="montant_paye_especes"
                                    class="form-control mb-2"
                                    disabled
                                    placeholder="Payé"
                                    title="Montant payé par le client">
                                <div class="monnaie-a-rendre">
                                    Monnaie à rendre: <span class="monnaie-montant">0.00€</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div>
                            <input type="checkbox"
                                name="mode_encaissement[]"
                                value="carte_bleu"
                                class="form-check-input"
                                title="Paiement par carte bancaire">
                            <label class="form-check-label">Carte bancaire</label>
                            <input type="number"
                                step="0.01"
                                name="montant_cb"
                                class="form-control montant-paiement"
                                disabled
                                title="Montant par carte">
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div>
                            <input type="checkbox"
                                name="mode_encaissement[]"
                                value="cheque"
                                class="form-check-input"
                                title="Paiement par chèque">
                            <label class="form-check-label">Chèque</label>
                            <input type="number"
                                step="0.01"
                                name="montant_cheque"
                                class="form-control montant-paiement"
                                disabled
                                title="Montant par chèque">
                            <input type="text"
                                name="numero_cheque"
                                class="form-control mt-2"
                                placeholder="Numéro du chèque"
                                disabled
                                title="Numéro du chèque">
                        </div>
                    </div>
                </div>
                <p class="mt-3">Montant restant à payer: <span id="montant_restant">0.00€</span></p>
            </div>

            <!-- Options supplémentaires -->
            <div class="facture-checkbox">
                <label for="creer_facture" class="btn-facture">
                    <input type="checkbox"
                        id="creer_facture"
                        name="creer_facture"
                        value="1"
                        title="Générer une facture">
                    <i class="fas fa-file-invoice"></i> Créer une facture
                </label>
            </div>

            <div class="form-group mt-4">
                <label for="commentaire">Commentaire:</label>
                <textarea name="commentaire"
                    id="commentaire"
                    class="form-control"
                    title="Ajouter un commentaire à la vente"></textarea>
            </div>

            <!-- Bouton de soumission -->
            <button type="submit"
                class="btn btn-primary mt-4"
                title="Enregistrer la vente">
                <i class="fas fa-save"></i> Enregistrer la vente
            </button>
            
            <!-- CSRF Token -->
            <input type="hidden" name="_token" value="{{ csrf_token('vente_form') }}">
        </form>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {# Removing the reference to the non-existent 'ventes' entry point #}
    {# {{ encore_entry_script_tags('ventes') }} #}
    
    {# Use an available entry point instead #}
    {{ encore_entry_script_tags('app') }}
    
    <script>
        // Add any custom JavaScript for the ventes page here
        document.addEventListener('DOMContentLoaded', function() {
            // Handle product selection
            const productSelects = document.querySelectorAll('.produit-select');
            productSelects.forEach(select => {
                select.addEventListener('change', updatePrices);
            });
            
            // Handle quantity changes
            const quantityInputs = document.querySelectorAll('.quantite');
            quantityInputs.forEach(input => {
                input.addEventListener('change', updatePrices);
            });
            
            // Handle add product button
            const addProductButton = document.getElementById('ajouter-produit');
            if (addProductButton) {
                addProductButton.addEventListener('click', function() {
                    // Clone the first product row and append it
                    const firstRow = document.querySelector('.produit-ligne');
                    const newRow = firstRow.cloneNode(true);
                    
                    // Reset values in the new row
                    newRow.querySelector('.produit-select').selectedIndex = 0;
                    newRow.querySelector('.quantite').value = 1;
                    newRow.querySelector('.prix-total').textContent = '';
                    newRow.querySelector('.montant-a-rembourser').textContent = '';
                    
                    // Add event listeners to the new elements
                    newRow.querySelector('.produit-select').addEventListener('change', updatePrices);
                    newRow.querySelector('.quantite').addEventListener('change', updatePrices);
                    newRow.querySelector('.supprimer-produit').addEventListener('click', deleteRow);
                    
                    // Append the new row
                    document.querySelector('.produits-container').appendChild(newRow);
                });
            }
            
            // Set up delete row functionality
            const deleteButtons = document.querySelectorAll('.supprimer-produit');
            deleteButtons.forEach(button => {
                button.addEventListener('click', deleteRow);
            });
            
            // Functions
            function updatePrices() {
                // Implementation would go here
                console.log('Updating prices');
            }
            
            function deleteRow(event) {
                // Only delete if there's more than one product row
                const rows = document.querySelectorAll('.produit-ligne');
                if (rows.length > 1) {
                    event.target.closest('.produit-ligne').remove();
                    updatePrices();
                }
            }
        });
    </script>
{% endblock %}