{% extends 'base.html.twig' %}

{% block title %}Liste des ventes
{% endblock %}


{% block content %}
	<div class="container">
		{% set current_route = app.request.attributes.get('_route') %}
		{% include 'partials/_ventes_breadcrumb.html.twig' with {'current_route': current_route} %}

		<div class="row mb-4 d-flex justify-content-between align-items-center">
			<div class="col-md-6">
				<h1>Liste des ventes</h1>
			</div>
			<div class="col-md-6 text-end">
				<a href="{{ path('ventes_new') }}" class="btn btn-primary">
					<i class="fas fa-plus"></i>
					Nouvelle vente
				</a>
			</div>
		</div>

		{% for message in app.flashes('success') %}
			<div class="alert alert-success">
				{{ message }}
			</div>
		{% endfor %}

		<div class="card mb-4">
			<div class="card-header bg-light">
				<h5 class="mb-0">Filtres</h5>
			</div>
			<div class="card-body">
				<form method="GET" class="row g-3">
					<div class="col-md-4">
						<label for="date_debut" class="form-label">Date début</label>
						<input type="date" name="date_debut" id="date_debut" class="form-control" value="{{ dateDebut }}">
					</div>
					<div class="col-md-4">
						<label for="date_fin" class="form-label">Date fin</label>
						<input type="date" name="date_fin" id="date_fin" class="form-control" value="{{ dateFin }}">
					</div>
					<div class="col-md-4 d-flex align-items-end">
						<button type="submit" class="btn btn-primary me-2">Filtrer</button>
						<a href="{{ path('ventes_index') }}" class="btn btn-secondary">Réinitialiser</a>
					</div>
				</form>
			</div>
		</div>

		<div class="card">
			<div class="card-body">
				<div class="table-responsive">
					<table class="table table-hover" id="ventes-table">
						<thead>
							<tr>
								<th>
									<a href="{{ path('ventes_index', {'sort': 'client.nom', 'direction': currentSort == 'client.nom' and currentDirection == 'asc' ? 'desc' : 'asc', 'date_debut': dateDebut, 'date_fin': dateFin}) }}" class="text-dark text-decoration-none">
										Client
										<i class="fas fa-sort{{ currentSort == 'client.nom' ? '-' ~ (currentDirection == 'asc' ? 'up' : 'down') : '' }}"></i>
									</a>
								</th>
								<th>
									<a href="{{ path('ventes_index', {'sort': 'v.date', 'direction': currentSort == 'v.date' and currentDirection == 'asc' ? 'desc' : 'asc', 'date_debut': dateDebut, 'date_fin': dateFin}) }}" class="text-dark text-decoration-none">
										Date
										<i class="fas fa-sort{{ currentSort == 'v.date' ? '-' ~ (currentDirection == 'asc' ? 'up' : 'down') : '' }}"></i>
									</a>
								</th>
								<th>
									<a href="{{ path('ventes_index', {'sort': 'v.montant', 'direction': currentSort == 'v.montant' and currentDirection == 'asc' ? 'desc' : 'asc', 'date_debut': dateDebut, 'date_fin': dateFin}) }}" class="text-dark text-decoration-none">
										Montant
										<i class="fas fa-sort{{ currentSort == 'v.montant' ? '-' ~ (currentDirection == 'asc' ? 'up' : 'down') : '' }}"></i>
									</a>
								</th>
								<th>
									<a href="{{ path('ventes_index', {'sort': 'v.montantRegle', 'direction': currentSort == 'v.montantRegle' and currentDirection == 'asc' ? 'desc' : 'asc', 'date_debut': dateDebut, 'date_fin': dateFin}) }}" class="text-dark text-decoration-none">
										Montant réglé
										<i class="fas fa-sort{{ currentSort == 'v.montantRegle' ? '-' ~ (currentDirection == 'asc' ? 'up' : 'down') : '' }}"></i>
									</a>
								</th>
								<th>
									<a href="{{ path('ventes_index', {'sort': 'v.aRembourser', 'direction': currentSort == 'v.aRembourser' and currentDirection == 'asc' ? 'desc' : 'asc', 'date_debut': dateDebut, 'date_fin': dateFin}) }}" class="text-dark text-decoration-none">
										À rembourser
										<i class="fas fa-sort{{ currentSort == 'v.aRembourser' ? '-' ~ (currentDirection == 'asc' ? 'up' : 'down') : '' }}"></i>
									</a>
								</th>
								<th>
									<a href="{{ path('ventes_index', {
										'sort': 'sortPaiement',
										'direction': currentSort == 'sortPaiement' and currentDirection == 'asc' ? 'desc' : 'asc',
										'date_debut': dateDebut,
										'date_fin': dateFin
									}) }}" class="text-dark text-decoration-none">
										Mode de paiement
										<i class="fas fa-sort{{ currentSort == 'sortPaiement' ? '-' ~ (currentDirection == 'asc' ? 'up' : 'down') : '' }}"></i>
									</a>
								</th>
								<th>Actions</th>
							</tr>
						</thead>
						<tbody>
							{% for vente in pagination %}
								<tr>
									<td>
										{% if vente.client %}
											{{ vente.client.nom }}
											{{ vente.client.prenom }}
										{% else %}
											Client de passage
										{% endif %}
									</td>
									<td>{{ vente.date|date('d/m/Y H:i') }}</td>
									<td>{{ vente.montant|number_format(2, ',', ' ') }}
										€</td>
									<td>{{ vente.montantRegle|number_format(2, ',', ' ') }}
										€</td>
									<td>{{ vente.aRembourser|number_format(2, ',', ' ') }}
										€</td>
									<td>
										{% for paiement in vente.ventePaiements %}
											{% if paiement.modePaiement == 'especes' %}
												<span class="badge bg-primary">Espèces</span>
											{% elseif paiement.modePaiement == 'carte_bleu' %}
												<span class="badge bg-info">Carte Bancaire</span>
											{% elseif paiement.modePaiement == 'cheque' %}
												<span class="badge bg-warning">Chèque</span>
											{% endif %}
										{% endfor %}
									</td>
									<td>
										<div class="btn-group ">
											<a href="{{ path('ventes_show', {'id': vente.id}) }}" class="btn btn-sm btn-outline-info" title="Voir">
												<i class="fas fa-eye"></i>
											</a>

											{% if vente.ventePaiements|length > 0 %}
												<a href="{{ path('factures_show', {'venteId': vente.id}) }}" class="btn btn-sm btn-secondary" title="Voir facture">
													<i class="fas fa-file-invoice"></i>
												</a>
											{% endif %}

											{% if is_granted('ROLE_ADMIN') %}
												<a href="{{ path('ventes_edit', {'id': vente.id}) }}" class="btn btn-sm btn-outline-primary" title="Modifier">
													<i class="fas fa-edit"></i>
												</a>
												<button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal{{ vente.id }}" title="Supprimer">
													<i class="fas fa-trash"></i>
												</button>
											{% endif %}
										</div>

										<!-- Modal de confirmation pour la suppression -->
										{% if is_granted('ROLE_ADMIN') %}
											<div class="modal fade" id="deleteModal{{ vente.id }}" tabindex="-1" aria-labelledby="deleteModalLabel{{ vente.id }}" aria-hidden="true">
												<div class="modal-dialog">
													<div class="modal-content">
														<div class="modal-header">
															<h5 class="modal-title" id="deleteModalLabel{{ vente.id }}">Confirmer la suppression</h5>
															<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
														</div>
														<div class="modal-body">
															<p>Êtes-vous sûr de vouloir supprimer la vente #{{ vente.id }}
																?</p>
															<p class="text-danger">
																<strong>Cette action est irréversible.</strong>
															</p>
														</div>
														<div class="modal-footer">
															<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
															<form method="post" action="{{ path('ventes_delete', {'id': vente.id}) }}" style="display: inline;">
																<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ vente.id) }}">
																<button type="submit" class="btn btn-danger">Confirmer la suppression</button>
															</form>
														</div>
													</div>
												</div>
											</div>
										{% endif %}
									</td>
								</tr>
							{% else %}
								<tr>
									<td colspan="7" class="text-center">Aucune vente trouvée</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>

				
			</div>
		</div>
	</div>
    
{% endblock %}
